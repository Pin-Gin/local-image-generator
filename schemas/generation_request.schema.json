{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memoriela.local/schemas/generation_request.schema.json",
  "title": "MEMORIELA Generation Request",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "created_at_utc",
    "source",
    "user_text",
    "profile_id",
    "intent"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "source": {"enum": ["chat_ui", "cli", "api"]},
    "user_text": {"type": "string", "minLength": 1},
    "profile_id": {"type": "string", "minLength": 1},
    "intent": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["unparsed", "parsed", "needs_confirmation"]},
        "character": {"type": ["string", "null"]},
        "outfit": {"type": ["string", "null"]},
        "background": {"type": ["string", "null"]},
        "pose": {"type": ["string", "null"]},
        "expression": {"type": ["string", "null"]},
        "hair": {"type": ["string", "null"]},
        "rendering": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "options": {
      "type": "object",
      "properties": {
        "reuse_policy": {"enum": ["EXACT", "PREFER_EXISTING", "FORCE_NEW"]},
        "seed_mode": {"enum": ["PROFILE", "RANDOM", "FIXED"]},
        "seed": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
