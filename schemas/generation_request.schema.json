{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-rag.local/schemas/generation_request.schema.json",
  "title": "local-RAG Generation Request",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "created_at_utc",
    "source",
    "user_text",
    "profile_id",
    "intent",
    "prompt_input",
    "generation_domain",
    "target_mode"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "source": {"enum": ["chat_ui", "cli", "api"]},
    "user_text": {"type": "string", "minLength": 1},
    "profile_id": {"type": "string", "minLength": 1},
    "generation_domain": {"enum": ["free", "memoriela"]},
    "intent": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["unparsed", "parsed", "needs_confirmation"]},
        "character": {"type": ["string", "null"]},
        "characters": {
          "type": "array",
          "items": {"type": "string"}
        },
        "outfit": {"type": ["string", "null"]},
        "background": {"type": ["string", "null"]},
        "pose": {"type": ["string", "null"]},
        "expression": {"type": ["string", "null"]},
        "hair": {"type": ["string", "null"]},
        "rendering": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "prompt_input": {
      "type": "object",
      "required": ["mode", "positive", "negative", "json"],
      "properties": {
        "mode": {"enum": ["text", "json"]},
        "positive": {"type": "string", "minLength": 1},
        "negative": {"type": ["string", "null"]},
        "json": {"type": ["object", "null"]}
      },
      "additionalProperties": false
    },
    "target_mode": {"enum": ["free_text2img", "memoriela_character", "generic_text2img", "yura_img2img"]},
    "learning": {
      "type": "object",
      "required": [
        "registry_version",
        "selector",
        "selector_role",
        "selector_model",
        "selected_asset_ids",
        "reason"
      ],
      "properties": {
        "registry_version": {"type": "integer", "minimum": 1},
        "selector": {"const": "local-ai"},
        "selector_role": {"const": "generate"},
        "selector_model": {"type": "string", "minLength": 1},
        "selected_asset_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "reason": {"type": "string"}
      },
      "additionalProperties": false
    },
    "options": {
      "type": "object",
      "properties": {
        "reuse_policy": {"enum": ["EXACT", "PREFER_EXISTING", "FORCE_NEW"]},
        "seed_mode": {"enum": ["PROFILE", "RANDOM", "FIXED"]},
        "seed": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
