# local-RAG local Oracle / Git tool configuration
# Copy to .env.local-ai. Never commit real passwords.

LOCALRAG_ORACLE_DSN=127.0.0.1:1521/FREEPDB1
LOCALRAG_ORACLE_USER=LOCALRAG_KB1
LOCALRAG_ORACLE_PASSWORD=CHANGE_ME
LOCALRAG_ORACLE_SYSTEM_PASSWORD=CHANGE_ME

# Optional local clone used by the read-only Git tools.
# Example:
# LOCALRAG_MEMORIELA_ROOT=C:\Dev\MEMORIELA
LOCALRAG_MEMORIELA_ROOT=
